# 复制为 server/.env(或项目根 .env)后按需修改

# ---------- MySQL(与 docker-compose.yml 默认值一致) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=art
DB_PASSWORD=art123456
DB_NAME=art_school
# 开发环境自动同步表结构;生产环境请改为 false 并使用迁移
DB_SYNC=true

# ---------- 服务 ----------
PORT=3000
JWT_SECRET=please-change-me-in-production
JWT_EXPIRES_IN=7d

# ---------- 业务规则 ----------
# 开课前 N 小时内家长不可取消预约
CANCEL_DEADLINE_HOURS=2
# 剩余课时预警阈值
LOW_HOURS_THRESHOLD=3

# ---------- 微信小程序 ----------
# 开发环境保持 WX_MOCK=true:登录接口直接把 code 当 openid,配合小程序端 mock 登录使用
# 接真实微信时:改为 false,并填入小程序 AppId/Secret
WX_MOCK=true
WX_APPID=
WX_SECRET=
