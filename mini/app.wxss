/* 设计基调:冷蓝画布 + 品牌蓝点缀,画廊式留白 */
page {
  background: #f1f5fb;
  font-size: 28rpx;
  color: #1c2b40;
  line-height: 1.5;
}

button::after {
  border: none;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(30, 64, 120, 0.07);
}

.btn-primary {
  background: linear-gradient(135deg, #4a8cff, #2563eb);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.26);
}

.btn-primary[disabled] {
  background: #b9cdf4;
  color: #fff;
  box-shadow: none;
}

.btn-outline {
  background: #fff;
  color: #2563eb;
  border: 2rpx solid #2563eb;
  border-radius: 999rpx;
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  margin-right: 8rpx;
}

.tag-blue {
  background: #e7effc;
  color: #2e6be6;
}

.tag-green {
  background: #e8f6ec;
  color: #1f9d55;
}

.tag-orange {
  background: #fdf0e2;
  color: #dd7a1c;
}

.tag-red {
  background: #fdecea;
  color: #d9483b;
}

.tag-gray {
  background: #eaeff7;
  color: #8494ab;
}

.empty {
  text-align: center;
  color: #9dacc2;
  padding: 80rpx 0;
  font-size: 26rpx;
}
