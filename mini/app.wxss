page {
  background: #f5f6fa;
  font-size: 28rpx;
  color: #333;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: #4f7cff;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn-primary[disabled] {
  background: #b9c8f5;
  color: #fff;
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
}

.tag-blue {
  background: #e8f0ff;
  color: #4f7cff;
}

.tag-green {
  background: #e7f9ef;
  color: #23b26d;
}

.tag-orange {
  background: #fff3e0;
  color: #f59a23;
}

.tag-red {
  background: #ffece8;
  color: #f0442c;
}

.tag-gray {
  background: #f0f1f5;
  color: #909399;
}

.empty {
  text-align: center;
  color: #b0b3bb;
  padding: 80rpx 0;
  font-size: 26rpx;
}
