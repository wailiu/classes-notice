.hero {
  text-align: center;
  padding: 140rpx 0 56rpx;
}

.logo {
  width: 168rpx;
  height: 168rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 12rpx 32rpx rgba(30, 64, 120, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 92rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  margin-top: 32rpx;
}

.subtitle {
  color: #8494ab;
  font-size: 24rpx;
  margin-top: 16rpx;
  white-space: pre-line;
  line-height: 1.8;
  letter-spacing: 2rpx;
}

.desc {
  text-align: center;
  color: #9dacc2;
  font-size: 22rpx;
  margin-top: 20rpx;
}

.dev-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #dd7a1c;
  margin-bottom: 16rpx;
}

.mock-btn {
  margin: 8rpx 8rpx 8rpx 0;
}
