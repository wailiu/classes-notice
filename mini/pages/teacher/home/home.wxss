.header {
  background: linear-gradient(135deg, #f0653a, #f2924f);
  color: #fff;
  box-shadow: 0 10rpx 28rpx rgba(232, 84, 44, 0.24);
}

.hello {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.sub {
  font-size: 24rpx;
  opacity: 0.88;
  margin-top: 10rpx;
}

.day-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #948b7d;
  letter-spacing: 2rpx;
  margin: 24rpx 28rpx 0;
}

.row1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.course {
  font-size: 30rpx;
  font-weight: 600;
}

.row2 {
  display: flex;
  gap: 24rpx;
  color: #948b7d;
  font-size: 24rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}

.link {
  color: #e8542c;
  font-weight: 600;
  margin-left: auto;
}

.logout {
  text-align: center;
  color: #b6ac9d;
  font-size: 24rpx;
  margin: 32rpx 0;
}
