.header {
  background: linear-gradient(135deg, #4a8cff, #7db0ff);
  color: #fff;
  box-shadow: 0 10rpx 28rpx rgba(37, 99, 235, 0.24);
}

.hello {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.sub {
  font-size: 24rpx;
  opacity: 0.88;
  margin-top: 10rpx;
}

.day-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #8494ab;
  letter-spacing: 2rpx;
  margin: 24rpx 28rpx 0;
}

.row1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.course {
  font-size: 30rpx;
  font-weight: 600;
}

.row2 {
  display: flex;
  gap: 24rpx;
  color: #8494ab;
  font-size: 24rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}

.link {
  color: #2563eb;
  font-weight: 600;
  margin-left: auto;
}

.logout {
  text-align: center;
  color: #9dacc2;
  font-size: 24rpx;
  margin: 32rpx 0;
}
