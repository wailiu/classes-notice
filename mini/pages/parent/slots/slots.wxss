.has-bar {
  padding-bottom: 160rpx;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.head-course {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* ---------- 预约方式 ---------- */
.mode-tabs {
  display: flex;
  background: #eaeff7;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  padding: 14rpx 0;
  border-radius: 999rpx;
  color: #5f6f85;
}

.mode-tab.active {
  background: #fff;
  color: #2563eb;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(30, 64, 120, 0.1);
}

/* ---------- 时段筛选(仅辅助浏览,不限制勾选) ---------- */
.filter-bar {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  margin-bottom: 18rpx;
}

.chip {
  flex: 1 0 auto;
  box-sizing: border-box;
  border: 2rpx solid #dbe4f0;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  margin-right: 14rpx;
  text-align: center;
  font-size: 24rpx;
  color: #5f6f85;
  background: #fff;
}

.chip:last-child {
  margin-right: 0;
}

.chip.active {
  border-color: #2563eb;
  background: #e8f0fd;
  color: #2563eb;
  font-weight: 600;
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.list-tip {
  font-size: 24rpx;
  color: #8494ab;
}

.select-all {
  font-size: 24rpx;
  color: #2563eb;
  font-weight: 600;
}

.sub-title {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  margin: 24rpx 0 14rpx;
}

.sub-title:first-child {
  margin-top: 0;
}

.sub-tip {
  font-size: 22rpx;
  font-weight: 400;
  color: #8494ab;
  margin-left: 12rpx;
}

/* ---------- 课次勾选 ---------- */
.lesson-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 12rpx;
  border-radius: 16rpx;
  border-bottom: 1rpx solid #e8eef6;
}

.lesson-row.disabled {
  opacity: 0.55;
}

.lesson-row.checked {
  background: #eef4fd;
  border-bottom-color: transparent;
}

/* ---------- 每周课程勾选(长期预约) ---------- */
.pattern-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 2rpx solid #dbe4f0;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 14rpx;
}

.pattern-row.checked {
  border-color: #2563eb;
  background: #eef4fd;
}

.checkbox {
  width: 38rpx;
  height: 38rpx;
  border: 2rpx solid #c3d0e2;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  flex-shrink: 0;
}

.checkbox.on {
  background: #2563eb;
  border-color: #2563eb;
}

.lesson-info {
  flex: 1;
}

.lesson-date {
  font-size: 28rpx;
  font-weight: 500;
}

.lesson-time {
  font-size: 22rpx;
  color: #8494ab;
  margin-top: 6rpx;
}

/* ---------- 长期预约 ---------- */
.range-opts {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.range-opt {
  flex: 1;
  text-align: center;
  border: 2rpx solid #dbe4f0;
  border-radius: 999rpx;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #5f6f85;
}

.range-opt.active {
  border-color: #2563eb;
  background: #e8f0fd;
  color: #2563eb;
  font-weight: 600;
}

.lt-summary {
  background: #f3f7fd;
  border-radius: 16rpx;
  padding: 22rpx;
  margin-top: 18rpx;
  font-size: 26rpx;
}

.hl {
  color: #2563eb;
  font-weight: 700;
}

.lt-warn {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #d9483b;
}

/* ---------- 底部提交栏 ---------- */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 20rpx rgba(30, 64, 120, 0.08);
}

.bar-info {
  flex: 1;
  font-size: 24rpx;
  color: #5f6f85;
}

.bar-btn {
  width: 260rpx;
  margin: 0;
}

/* ---------- 结果面板 ---------- */
.result-mask {
  position: fixed;
  inset: 0;
  background: rgba(28, 43, 64, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.result-panel {
  width: 620rpx;
  max-height: 75vh;
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  display: flex;
  flex-direction: column;
}

.result-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  letter-spacing: 1rpx;
}

.result-summary {
  font-size: 26rpx;
  text-align: center;
  color: #5f6f85;
  margin: 18rpx 0;
}

.result-list {
  flex: 1;
  max-height: 40vh;
}

.result-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #e8eef6;
}

.ok-text {
  color: #1f9d55;
  font-weight: 600;
}

.fail-text {
  color: #d9483b;
  max-width: 260rpx;
  text-align: right;
}

.result-btn {
  margin-top: 28rpx;
}
