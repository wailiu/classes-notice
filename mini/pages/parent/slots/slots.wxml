<view class="page has-bar">
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{!slots.length}}" class="empty">该课种未来暂无排课</view>

  <block wx:if="{{!loading && slots.length}}">
    <!-- 课种概览 -->
    <view class="card head">
      <view class="head-course">{{courseName}}</view>
      <text class="tag {{remaining <= 3 ? 'tag-red' : 'tag-green'}}">剩 {{remaining}} 课时</text>
    </view>

    <!-- 预约方式 -->
    <view class="card">
      <view class="mode-tabs">
        <view class="mode-tab {{mode === 'single' ? 'active' : ''}}" data-mode="single" bindtap="switchMode">单次预约</view>
        <view class="mode-tab {{mode === 'longterm' ? 'active' : ''}}" data-mode="longterm" bindtap="switchMode">长期预约</view>
      </view>

      <!-- 单次:全部时段课次同屏,可跨时段多选 -->
      <block wx:if="{{mode === 'single'}}">
        <scroll-view scroll-x class="filter-bar" enable-flex>
          <view
            wx:for="{{filterOptions}}"
            wx:key="classId"
            wx:for-item="opt"
            class="chip {{filterClassId === opt.classId ? 'active' : ''}}"
            data-class-id="{{opt.classId}}"
            bindtap="setFilter"
          >
            {{opt.label}}
          </view>
        </scroll-view>
        <view class="list-head">
          <text class="list-tip">勾选要预约的课次(可跨时段多选)</text>
          <text class="select-all" bindtap="selectAllBookable">全选可约</text>
        </view>
        <view wx:if="{{!lessons.length}}" class="empty small">该筛选下未来暂无课次</view>
        <view
          wx:for="{{lessons}}"
          wx:key="id"
          wx:for-item="lesson"
          class="lesson-row {{lesson.checked ? 'checked' : ''}} {{lesson.canBook ? '' : 'disabled'}}"
          data-id="{{lesson.id}}"
          bindtap="toggleLesson"
        >
          <view class="checkbox {{lesson.checked ? 'on' : ''}}">{{lesson.checked ? '✓' : ''}}</view>
          <view class="lesson-info">
            <view class="lesson-date">
              {{lesson.date}} {{lesson.weekdayText}}{{lesson.period}}
            </view>
            <view class="lesson-time">{{lesson.startTime}}-{{lesson.endTime}} · {{lesson.teacherName}} · {{lesson.room}}</view>
          </view>
          <text wx:if="{{lesson.canBook}}" class="tag tag-blue">余位 {{lesson.remainingSeats}}</text>
          <text wx:elif="{{lesson.alreadyBooked}}" class="tag tag-green">已预约</text>
          <text wx:else class="tag tag-gray">{{lesson.reason}}</text>
        </view>
      </block>

      <!-- 长期:勾选每周课程 × 日期范围 → 课次列表 -->
      <block wx:else>
        <view class="sub-title">勾选要每周重复预约的课程(可多选)</view>
        <view
          wx:for="{{patterns}}"
          wx:key="classId"
          wx:for-item="pattern"
          class="pattern-row {{pattern.checked ? 'checked' : ''}}"
          data-class-id="{{pattern.classId}}"
          bindtap="togglePattern"
        >
          <view class="checkbox {{pattern.checked ? 'on' : ''}}">{{pattern.checked ? '✓' : ''}}</view>
          <view class="lesson-info">
            <view class="lesson-date">每{{pattern.label}} {{pattern.startTime}}-{{pattern.endTime}}</view>
            <view class="lesson-time">{{pattern.teacherName}} · {{pattern.room}}</view>
          </view>
        </view>

        <view class="sub-title">选择日期范围</view>
        <view class="range-opts">
          <view
            wx:for="{{rangeOptions}}"
            wx:key="days"
            wx:for-item="opt"
            class="range-opt {{rangeDays === opt.days ? 'active' : ''}}"
            data-days="{{opt.days}}"
            bindtap="setRange"
          >
            {{opt.label}}
          </view>
        </view>

        <view class="sub-title">
          范围内课次
          <text class="sub-tip">可约课次已默认勾选,可点选取消;不可约展示原因</text>
        </view>
        <view wx:if="{{!ltLessons.length}}" class="empty small">请先勾选每周课程,范围内暂无对应课次</view>
        <view
          wx:for="{{ltLessons}}"
          wx:key="id"
          wx:for-item="lesson"
          class="lesson-row {{lesson.ltChecked ? 'checked' : ''}} {{lesson.canBook ? '' : 'disabled'}}"
          data-id="{{lesson.id}}"
          bindtap="toggleLtLesson"
        >
          <view class="checkbox {{lesson.ltChecked ? 'on' : ''}}">{{lesson.ltChecked ? '✓' : ''}}</view>
          <view class="lesson-info">
            <view class="lesson-date">
              {{lesson.date}} {{lesson.weekdayText}}{{lesson.period}}
            </view>
            <view class="lesson-time">{{lesson.startTime}}-{{lesson.endTime}} · {{lesson.teacherName}} · {{lesson.room}}</view>
          </view>
          <text wx:if="{{lesson.canBook}}" class="tag tag-blue">余位 {{lesson.remainingSeats}}</text>
          <text wx:elif="{{lesson.alreadyBooked}}" class="tag tag-green">已预约</text>
          <text wx:else class="tag tag-gray">{{lesson.reason}}</text>
        </view>

        <view wx:if="{{ltLessons.length}}" class="lt-summary">
          将预约 <text class="hl">{{ltSelectedCount}}</text> 节,
          扣 <text class="hl">{{ltSelectedCount}}</text> 课时<block wx:if="{{ltBlockedCount}}">,{{ltBlockedCount}} 节不可约已跳过</block>
        </view>
        <view wx:if="{{ltSelectedCount > remaining}}" class="lt-warn">
          剩余课时不足(仅剩 {{remaining}}),请减少勾选、缩短范围或联系前台续费
        </view>
      </block>
    </view>
  </block>

  <!-- 底部提交栏 -->
  <view class="bottom-bar" wx:if="{{!loading && slots.length && !result}}">
    <view class="bar-info">
      <block wx:if="{{mode === 'single'}}">已选 {{selectedCount}} 节 · 扣 {{selectedCount}} 课时 · 剩 {{remaining}}</block>
      <block wx:else>将约 {{ltSelectedCount}} 节 · 扣 {{ltSelectedCount}} 课时 · 剩 {{remaining}}</block>
    </view>
    <button
      wx:if="{{mode === 'single'}}"
      class="btn-primary bar-btn"
      disabled="{{submitting || !selectedCount || selectedCount > remaining}}"
      bindtap="submitSingle"
    >
      {{submitting ? '提交中…' : '确认预约'}}
    </button>
    <button
      wx:else
      class="btn-primary bar-btn"
      disabled="{{submitting || !ltSelectedCount || ltSelectedCount > remaining}}"
      bindtap="submitLongterm"
    >
      {{submitting ? '提交中…' : '确认长期预约'}}
    </button>
  </view>

  <!-- 提交结果 -->
  <view class="result-mask" wx:if="{{result}}" bindtap="noop">
    <view class="result-panel">
      <view class="result-title">
        {{result.booked.length ? '预约完成' : '未能预约'}}
      </view>
      <view class="result-summary">
        成功 <text class="hl">{{result.booked.length}}</text> 节,
        扣除 <text class="hl">{{result.deducted}}</text> 课时,
        剩余 <text class="hl">{{result.remainingAfter}}</text> 课时
      </view>
      <scroll-view scroll-y class="result-list">
        <view wx:for="{{result.booked}}" wx:key="lessonId" wx:for-item="b" class="result-row ok">
          <text>✅ {{b.date}} {{b.startTime}}-{{b.endTime}}</text>
          <text class="ok-text">预约成功</text>
        </view>
        <view wx:for="{{result.failed}}" wx:key="lessonId" wx:for-item="f" class="result-row fail">
          <text>❌ {{f.date || '未知课次'}} {{f.startTime || ''}}</text>
          <text class="fail-text">{{f.reason}}</text>
        </view>
      </scroll-view>
      <button class="btn-primary result-btn" bindtap="closeResult">知道了</button>
    </view>
  </view>
</view>
