.row1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.course {
  font-size: 30rpx;
  font-weight: 600;
}

.row2 {
  display: flex;
  gap: 20rpx;
  color: #909399;
  font-size: 24rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.row3 {
  color: #b0b3bb;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.cancel-btn {
  margin-top: 16rpx;
  width: 100%;
  background: #fff;
  color: #f0442c;
  border: 1rpx solid #f0442c;
  border-radius: 12rpx;
  font-size: 26rpx;
}
