.tip {
  margin: 20rpx 24rpx 0;
  font-size: 24rpx;
  color: #909399;
}

.course-card {
  transition: opacity 0.2s;
}

.course-card.disabled {
  opacity: 0.62;
}

.row1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.course-name {
  font-size: 32rpx;
  font-weight: 600;
}

.slots {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.slot-chip {
  font-size: 22rpx;
  color: #4f7cff;
  background: #eef3ff;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.slot-chip.none {
  color: #b0b3bb;
  background: #f0f1f5;
}

.row3 {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.go {
  font-size: 26rpx;
  color: #4f7cff;
  font-weight: 500;
}

.no-book {
  font-size: 24rpx;
  color: #e6a23c;
}
