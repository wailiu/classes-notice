.day-block {
  margin-bottom: 8rpx;
}

.day-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #666;
  margin: 20rpx 24rpx 0;
}

.lesson {
  position: relative;
}

.row1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.course {
  font-size: 30rpx;
  font-weight: 600;
}

.row2 {
  display: flex;
  gap: 24rpx;
  color: #909399;
  font-size: 24rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.book-btn {
  margin-top: 16rpx;
  width: 100%;
}
