.tip {
  margin: 20rpx 28rpx 0;
  font-size: 24rpx;
  color: #948b7d;
}

.course-card {
  transition: opacity 0.2s;
}

.course-card.disabled {
  opacity: 0.62;
}

.row1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.course-name {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.slots {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.slot-chip {
  font-size: 22rpx;
  color: #d95f38;
  background: #fbf0e8;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
}

.slot-chip.none {
  color: #b6ac9d;
  background: #f1ede6;
}

.row3 {
  margin-top: 18rpx;
  display: flex;
  justify-content: flex-end;
}

.go {
  font-size: 26rpx;
  color: #e8542c;
  font-weight: 600;
}

.no-book {
  font-size: 24rpx;
  color: #dd7a1c;
}
