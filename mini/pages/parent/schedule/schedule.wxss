.tip {
  margin: 20rpx 28rpx 0;
  font-size: 24rpx;
  color: #8494ab;
}

.course-card {
  transition: opacity 0.2s;
}

.course-card.disabled {
  opacity: 0.62;
}

.row1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.course-name {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.slots {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.slot-chip {
  font-size: 22rpx;
  color: #2563eb;
  background: #e8f0fd;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
}

.slot-chip.none {
  color: #9dacc2;
  background: #eaeff7;
}

.row3 {
  margin-top: 18rpx;
  display: flex;
  justify-content: flex-end;
}

.go {
  font-size: 26rpx;
  color: #2563eb;
  font-weight: 600;
}

.no-book {
  font-size: 24rpx;
  color: #dd7a1c;
}
