<view class="page">
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{!courses.length}}" class="empty">暂无开设课种</view>

  <view wx:if="{{!loading && courses.length}}" class="tip">已购课种置顶,点击进入查看全部课次并勾选预约</view>

  <view
    wx:for="{{courses}}"
    wx:key="courseId"
    wx:for-item="course"
    class="card course-card {{course.bookable ? '' : 'disabled'}}"
    data-id="{{course.courseId}}"
    bindtap="enterCourse"
  >
    <view class="row1">
      <view class="course-name">{{course.courseName}}</view>
      <text wx:if="{{course.bookable}}" class="tag tag-green">剩 {{course.remaining}} 课时</text>
      <text wx:elif="{{course.purchased}}" class="tag tag-red">课时不足</text>
      <text wx:else class="tag tag-gray">未购买</text>
    </view>

    <view class="slots" wx:if="{{course.slots.length}}">
      <text class="slot-chip" wx:for="{{course.slots}}" wx:key="classId" wx:for-item="slot">
        {{slot.weekdayText}}{{slot.period}} {{slot.startTime}}-{{slot.endTime}}
      </text>
    </view>
    <view class="slots" wx:else>
      <text class="slot-chip none">暂未排课</text>
    </view>

    <view class="row3">
      <text wx:if="{{course.bookable}}" class="go">查看课次预约 ›</text>
      <text wx:else class="no-book">{{course.reason}}</text>
    </view>
  </view>
</view>
