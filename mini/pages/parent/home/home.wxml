<view class="page">
  <view class="header card">
    <view class="hello">您好,{{profile.name || '家长'}} 👋</view>
    <view class="sub">请选择孩子查看课时与预约</view>
  </view>

  <view class="card" wx:if="{{children.length}}">
    <view class="child-tabs">
      <view
        wx:for="{{children}}"
        wx:key="studentId"
        class="child-tab {{index === currentIndex ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="switchChild"
      >
        {{item.name}}
      </view>
    </view>

    <block wx:if="{{children[currentIndex]}}">
      <view class="summary">
        <view class="big-num">{{children[currentIndex].totalRemaining}}</view>
        <view class="big-label">总剩余课时</view>
      </view>

      <view class="pkg-title">课时包明细</view>
      <view wx:if="{{!children[currentIndex].packages.length}}" class="empty">暂无生效课时包,请联系前台购买</view>
      <view class="pkg" wx:for="{{children[currentIndex].packages}}" wx:key="id">
        <view class="pkg-name">{{item.name}}</view>
        <view class="pkg-meta">
          <text class="tag tag-blue">{{item.courseName}}</text>
          <text class="tag {{item.remainingLessons <= 3 ? 'tag-red' : 'tag-green'}}">
            剩 {{item.remainingLessons}}/{{item.totalLessons}} 课时
          </text>
          <text class="tag tag-gray" wx:if="{{item.validUntil}}">有效期至 {{item.validUntil}}</text>
        </view>
      </view>

      <view class="actions">
        <button class="btn-primary action-btn" bindtap="goSchedule">预约课程</button>
        <button class="action-btn outline" bindtap="goBookings">预约记录</button>
      </view>
    </block>
  </view>

  <view class="card" wx:if="{{!loading && !children.length}}">
    <view class="empty">当前账号名下暂无孩子档案\n请联系前台绑定</view>
  </view>

  <view class="logout" bindtap="logout">退出登录</view>
</view>
