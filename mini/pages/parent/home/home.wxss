.header {
  background: linear-gradient(135deg, #4f7cff, #6f9bff);
  color: #fff;
}

.hello {
  font-size: 34rpx;
  font-weight: 600;
}

.sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

.child-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.child-tab {
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  background: #f0f1f5;
  color: #666;
  font-size: 26rpx;
}

.child-tab.active {
  background: #4f7cff;
  color: #fff;
}

.summary {
  text-align: center;
  padding: 20rpx 0 30rpx;
}

.big-num {
  font-size: 72rpx;
  font-weight: 700;
  color: #4f7cff;
}

.big-label {
  color: #909399;
  font-size: 24rpx;
}

.pkg-title {
  font-weight: 600;
  margin-bottom: 12rpx;
}

.pkg {
  border-top: 1rpx solid #f0f1f5;
  padding: 16rpx 0;
}

.pkg-name {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.action-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.outline {
  background: #fff;
  color: #4f7cff;
  border: 1rpx solid #4f7cff;
}

.empty {
  white-space: pre-line;
}

.logout {
  text-align: center;
  color: #b0b3bb;
  font-size: 24rpx;
  margin: 30rpx 0;
}
