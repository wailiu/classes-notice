.header {
  background: linear-gradient(135deg, #f0653a, #f2924f);
  color: #fff;
  box-shadow: 0 10rpx 28rpx rgba(232, 84, 44, 0.24);
}

.hello {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.sub {
  font-size: 24rpx;
  opacity: 0.88;
  margin-top: 10rpx;
}

.child-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.child-tab {
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: #f1ede6;
  color: #7a7266;
  font-size: 26rpx;
}

.child-tab.active {
  background: #2b241c;
  color: #fff;
  font-weight: 600;
}

.summary {
  text-align: center;
  padding: 24rpx 0 32rpx;
}

.big-num {
  font-size: 88rpx;
  font-weight: 700;
  color: #e8542c;
  line-height: 1.1;
}

.big-label {
  color: #948b7d;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  margin-top: 4rpx;
}

.pkg-title {
  font-weight: 600;
  margin-bottom: 12rpx;
}

.pkg {
  border-top: 1rpx solid #f3efe8;
  padding: 20rpx 0;
}

.pkg-name {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.action-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 999rpx;
}

.outline {
  background: #fff;
  color: #e8542c;
  border: 2rpx solid #e8542c;
}

.empty {
  white-space: pre-line;
}

.logout {
  text-align: center;
  color: #b6ac9d;
  font-size: 24rpx;
  margin: 32rpx 0;
}
