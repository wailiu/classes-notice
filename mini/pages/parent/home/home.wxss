.header {
  background: linear-gradient(135deg, #4a8cff, #7db0ff);
  color: #fff;
  box-shadow: 0 10rpx 28rpx rgba(37, 99, 235, 0.24);
}

.hello {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.sub {
  font-size: 24rpx;
  opacity: 0.88;
  margin-top: 10rpx;
}

.child-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.child-tab {
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: #eaeff7;
  color: #5f6f85;
  font-size: 26rpx;
}

.child-tab.active {
  background: #1c2b40;
  color: #fff;
  font-weight: 600;
}

.summary {
  text-align: center;
  padding: 24rpx 0 32rpx;
}

.big-num {
  font-size: 88rpx;
  font-weight: 700;
  color: #2563eb;
  line-height: 1.1;
}

.big-label {
  color: #8494ab;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  margin-top: 4rpx;
}

.pkg-title {
  font-weight: 600;
  margin-bottom: 12rpx;
}

.pkg {
  border-top: 1rpx solid #e8eef6;
  padding: 20rpx 0;
}

.pkg-name {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.action-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 999rpx;
}

.outline {
  background: #fff;
  color: #2563eb;
  border: 2rpx solid #2563eb;
}

.empty {
  white-space: pre-line;
}

.logout {
  text-align: center;
  color: #9dacc2;
  font-size: 24rpx;
  margin: 32rpx 0;
}
